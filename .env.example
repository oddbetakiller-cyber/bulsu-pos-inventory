# Copy this file to .env and fill in values from a dedicated Firebase demo project.
# Do not use the production bulsu-pos project for a public demo deployment.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-demo-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-demo-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-demo-project
VITE_FIREBASE_STORAGE_BUCKET=your-demo-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=
